<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="RepositoryProvider" value="EF" />
  </appSettings>
  <connectionStrings>
    <add name="F1Database"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=F1DriverSystemLab2;Integrated Security=True;Connect Timeout=30"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
